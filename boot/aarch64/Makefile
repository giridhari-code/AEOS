# ============================================================
# AEOS Makefile
# Architecture: ARM64 (AArch64)
# ============================================================

CC      = aarch64-linux-gnu-gcc
AS      = aarch64-linux-gnu-as
LD      = aarch64-linux-gnu-ld
OBJCOPY = aarch64-linux-gnu-objcopy
SIZE    = aarch64-linux-gnu-size
GENBIN2C = python3 ../../tools/build/bin2c.py

ASFLAGS = -g
CFLAGS  = -Wall -Wextra -Werror -O2 -std=c11 -ffreestanding -nostdlib \
          -mgeneral-regs-only -DAEOS_HAS_VMM -DVNET_SINGLE_DESC_TEST -mstrict-align -I. -I../../kernel \
          -I$(BUILD_DIR)/users -g
LDFLAGS = -T linker.ld -nostdlib --gc-sections -z max-page-size=4096

# User programs (EL0): assembled flat, linked at USER_VA_BASE, then
# embedded into the kernel as generated byte arrays.
USER_DIR  = users
USERS     = ping pong
USER_ELFS = $(addprefix $(BUILD_DIR)/users/,$(USERS:=.elf))
USER_BINS = $(addprefix $(BUILD_DIR)/users/,$(USERS:=.bin))
USER_HDRS = $(patsubst %,$(BUILD_DIR)/users/userprog_%.h,$(USERS))

# Subsystem sources living outside boot/aarch64 (resolved via VPATH)
SUBSYSTEM_DIR = ../../kernel
VPATH = $(SUBSYSTEM_DIR) $(USER_DIR)

BUILD_DIR = build
KERNEL_ELF = $(BUILD_DIR)/kernel.elf
KERNEL_BIN = $(BUILD_DIR)/kernel.bin

ASM_SRC = boot.S exceptions.S switch.S smp_entry.S
C_SRC   = kernel.c loader.c pmm.c vmm.c heap.c utils.c gic.c timer.c irq.c virtio.c uart.c ai_core.c ai_api.c ai_learn.c ai_debug.c sched.c sync.c shell.c syscall.c proc.c afs.c tui.c smp.c vnet.c net.c cmt_core.c cmt_api.c device.c ramfs.c ipc.c psci.c

ASM_OBJ = $(addprefix $(BUILD_DIR)/, $(ASM_SRC:.S=.o))
C_OBJ   = $(addprefix $(BUILD_DIR)/, $(C_SRC:.c=.o))
ALL_OBJ = $(ASM_OBJ) $(C_OBJ)

.PHONY: all clean size

all: $(KERNEL_BIN)
	@echo "Build complete: $(KERNEL_BIN)"

$(KERNEL_ELF): $(ALL_OBJ) linker.ld
	@mkdir -p $(BUILD_DIR)
	$(LD) $(LDFLAGS) $(ALL_OBJ) -o $@

$(KERNEL_BIN): $(KERNEL_ELF)
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# kernel.c embeds the generated user program headers.
$(BUILD_DIR)/kernel.o: $(USER_HDRS)

$(BUILD_DIR)/%.o: %.S
	@mkdir -p $(BUILD_DIR)
	$(AS) $(ASFLAGS) $< -o $@

# ---- User program pipeline ----------------------------------
# %.s -> (build dir object) -> link at USER_VA_BASE -> flat .bin ->
#        generated C header with the image bytes.

$(BUILD_DIR)/users/%.elf: $(USER_DIR)/%.s users/user.ld
	@mkdir -p $(BUILD_DIR)/users
	$(AS) $(ASFLAGS) $< -o $(BUILD_DIR)/users/$*.o
	$(LD) -T users/user.ld -nostdlib \
	      $(BUILD_DIR)/users/$*.o -o $@

$(BUILD_DIR)/users/%.bin: $(BUILD_DIR)/users/%.elf
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/users/userprog_%.h: $(BUILD_DIR)/users/%.bin
	$(GENBIN2C) $< user_prog_$* > $@

size: $(KERNEL_ELF)
	$(SIZE) $<

clean:
	rm -rf $(BUILD_DIR)
