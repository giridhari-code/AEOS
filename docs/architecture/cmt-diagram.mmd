%% CMT (Consciousness Manifold Theory) - Mermaid Diagram
%% Core Formula: C = E_f
%% Source: docs/architecture/CMT.md

graph LR
    subgraph Inputs ["Multiple Inputs"]
        P["🔵 P<br/>Perception"]
        M["🟢 M<br/>Memory"]
        B["🟠 B<br/>Body State"]
        S["🩷 S<br/>Self-Model"]
        A["🟣 A<br/>Action"]
        O["⚪ ...<br/>Other Inputs"]
    end

    IM(("<b>IM</b><br/>Input Manifold<br/><i>High-Dimensional Space</i>"))
    T["<b>T</b><br/>Manifold Transformation<br/><i>Integration · Selection<br/>Compression · Mapping</i>"]
    Ef(("<b>E_f</b><br/>Embedded Experience"))
    C["<b>C</b><br/>Consciousness<br/><i>Unified Experience</i>"]

    P -->|"sensory data"| IM
    M -->|"stored patterns"| IM
    B -->|"proprioception"| IM
    S -->|"self-representation"| IM
    A -->|"motor output"| IM
    O -->|"context signals"| IM

    IM -->|"converge"| T
    T -->|"compress"| Ef
    Ef -->|"emerge"| C

    style Inputs fill:#e8f4f8,stroke:#2196F3,stroke-width:2px
    style IM fill:#e3f2fd,stroke:#1565C0,stroke-width:2px
    style T fill:#e8f5e9,stroke:#2E7D32,stroke-width:2px
    style Ef fill:#fff8e1,stroke:#F9A825,stroke-width:2px
    style C fill:#fce4ec,stroke:#C62828,stroke-width:2px
